{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxTweakers",
  "version": "1.0.39",
  "identifier": "com.dgeras.fluxtweakers",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FluxTweakers — Painel de Otimização",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dgeras308-ai/FluxTweakers/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNUExMTU0QTc3MTg2QzgKUldUSWhuR25WQkZhUHVrWEdxL2pUS2s4V2RubkFWbzBhVmR2Yi83Rlk3ek5ZNy9Ma2d1K2M2ZlAK"
    }
  }
}



